cat > .env.example << 'EOF'
# ====== ENVIRONMENT ======
ENVIRONMENT=development  # development | test | production

# ====== SECURITY ======
# MUST be set in production. Use at least 32 chars.
JWT_SECRET=change_me_to_a_long_random_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=60

# ====== DATABASE ======
# Local dev (sqlite):
# DATABASE_URL=sqlite:///./cryptofile.db
# Docker/Postgres:
DATABASE_URL=postgresql+psycopg2://cryptofile:cryptofile@db:5432/cryptofile

# ====== CORS ======
# Comma-separated list. Example:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# ====== STORAGE ======
UPLOAD_DIR=/app/uploads
EOF